{
  "name": "homepage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/*", "!/assets/*", "!/images/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bubuhani-db", "database_id": "f9659050-89c0-490b-bde0-cd06f0da91ea" }
  ],
  // 매일 새벽 3시(한국 시간): 보관 기간이 지난 예약 삭제
  "triggers": { "crons": ["0 18 * * *"] },
  "vars": {
    // 환자 온라인 예약: "on" 이면 받습니다
    "BOOKING_OPEN": "on",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
